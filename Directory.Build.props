<Project>

  <!-- Gemeinsame Einstellungen für alle Projekte der Solution.
       Bewusst hier und nicht je Projekt, damit Sprachstand und Null-Sicherheit
       überall identisch sind. -->
  <PropertyGroup>
    <LangVersion>10.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Null-Warnungen sind Fehler: eine vergessene Prüfung soll den Build brechen,
         nicht erst im Backtest auffallen. Paket-/Kompatibilitätswarnungen bleiben Warnungen. -->
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Damit ausführbare Projekte (Tests, später der Backtester) auch dann starten,
         wenn auf der Maschine nur eine neuere .NET-Runtime als 8 installiert ist.
         Erspart auf Windows- und Mac-Rechnern die Frage, welche Runtime genau fehlt. -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

</Project>
