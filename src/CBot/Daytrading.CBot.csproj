<Project Sdk="Microsoft.NET.Sdk">

  <!-- cTrader-Adapter. Zielt auf net6.0, weil das NuGet-Paket cTrader.Automate auf .NET 6
       und .NET Framework 4.0 zielt. Die referenzierten Bibliotheken sind netstandard2.0 und
       laden deshalb hier ebenso wie im Backtester auf net8.0.

       In diesem Projekt steht KEINE Handelslogik. Landet hier eine Regel, ist etwas
       schiefgelaufen: Sie gehört nach /Strategies oder /Execution und wäre hier weder
       backtestbar noch testbar. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Daytrading.CBot</AssemblyName>
    <RootNamespace>Daytrading.CBot</RootNamespace>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.19" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Evaluation\Daytrading.Evaluation.csproj" />
    <ProjectReference Include="..\Execution\Daytrading.Execution.csproj" />
    <ProjectReference Include="..\Strategies\Daytrading.Strategies.csproj" />
  </ItemGroup>

  <!-- Das SDK von cTrader benennt das Paket nach dem Ordner ueber dem Projekt, hier also
       "src.algo". Der Name steht im Dateisystem des Anwenders, nicht im Paket - cTrader liest
       den Robotnamen aus den Metadaten -, deshalb wird die fertige Datei unter einem
       sprechenden Namen nach /dist kopiert. Das ist die Datei zum Importieren. -->
  <Target Name="CopyAlgoPackage" AfterTargets="Build">
    <PropertyGroup>
      <_DistDirectory>$(MSBuildThisFileDirectory)..\..\dist\</_DistDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(_DistDirectory)" />
    <Copy SourceFiles="$(OutDir)src.algo"
          DestinationFiles="$(_DistDirectory)DaytradingBot.algo"
          Condition="Exists('$(OutDir)src.algo')" />
    <Message Importance="high"
             Text="cTrader-Paket: $(_DistDirectory)DaytradingBot.algo"
             Condition="Exists('$(OutDir)src.algo')" />
  </Target>

</Project>
