<Project Sdk="Microsoft.NET.Sdk">

  <!-- Eigenes Projekt, weil cTrader je Assembly genau einen Algo-Typ erlaubt.
       Der Export-cBot braucht nichts vom Framework - er schreibt nur Bars als CSV. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Daytrading.CBot.Export</AssemblyName>
    <RootNamespace>Daytrading.CBot</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.19" />
  </ItemGroup>

  <!-- Siehe Daytrading.CBot.csproj: das SDK benennt das Paket nach dem Ordner ueber dem
       Projekt. Beide Projekte liegen unter /src und wuerden dieselbe Datei erzeugen. -->
  <Target Name="CopyAlgoPackage" AfterTargets="_AlgoBuildAfterBuild">
    <PropertyGroup>
      <_DistDirectory>$(MSBuildThisFileDirectory)..\..\dist\</_DistDirectory>
    </PropertyGroup>
    <MakeDir Directories="$(_DistDirectory)" />
    <Copy SourceFiles="$(OutDir)src.algo"
          DestinationFiles="$(_DistDirectory)DaytradingBarExport.algo"
          Condition="Exists('$(OutDir)src.algo')" />
    <Message Importance="high"
             Text="cTrader-Paket: $(_DistDirectory)DaytradingBarExport.algo"
             Condition="Exists('$(OutDir)src.algo')" />
  </Target>

</Project>
